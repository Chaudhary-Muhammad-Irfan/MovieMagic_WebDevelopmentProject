@model CORE.Entities.MovieShows
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="~/css/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/adminforms.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <h2 class="mb-4 text-center">Add Show</h2>  
        <form method="post" action="/Admin/AddShow">
            @* <div class="form-group">
                <label for="movieId">Show ID:</label>
                <input type="number" class="form-control" id="showId" name="showId" min="1" required>
            </div> *@
            <div class="form-group">
                <label for="movieId">Movie ID:</label>
                <input type="number" class="form-control" id="movieId" name="movieId" min="1" required>
            </div>
            <div class="form-group">
                <label for="movieName">Movie Name:</label>
                <input type="text" class="form-control" id="movieName" name="movieName" required>
            </div>
            <div class="form-group">
                <label for="ShowDate">Show Date:</label>
                <input type="date" class="form-control" id="showDate" name="showDate" required>
            </div>
            <div class="form-group">
                <label for="ShowTime">Show Time:</label>
                <input type="time" class="form-control" id="showTime" name="showTime" required>
            </div>
            <div class="form-group">
                <label for="showDay">Day:</label>
                <select class="form-control" id="showDay" name="showDay">
                    <option value="Sunday">Sunday</option>
                    <option value="Monday">Monday</option>
                    <option value="Tuesday">Tuesday</option>
                    <option value="Wednesday">Wednesday</option>
                    <option value="Thursday">Thursday</option>
                    <option value="Friday">Friday</option>
                    <option value="Saturday">Saturday</option>
                </select>
            </div>
            <div class="form-group text-center">
                <button type="submit" class="btn btn-primary">Add</button>
            </div>
        </form>
    </div>
    <script src="~/js/js/bootstrap.bundle.js"></script>
</body>
</html>