@model CORE.Entities.MovieShows
@{
	Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registered Users</title>
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
        }

        .table-hover tbody tr:hover {
            background-color: #f5f5f5;
            cursor: pointer;
        }

        .center-title {
            text-align: center;
        }

        .container-bounded {
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 20px;
            overflow: auto;
            max-height: 400px;
        }

        .table-container {
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 10px;
            overflow: auto;
        }
    </style>
</head>
<body>
    <div class="container mt-4">
        <div class="container-bounded">
            <div class="center-title mb-4">
                <h1>Movie Shows</h1>
            </div>
            <div class="table-container">
                <table class="table table-hover">
                    <thead class="thead-light">
                        <tr>
                            <th>Show ID</th>
                            <th>Movie Name</th>
                            <th>Show Date</th>
                            <th>Show Time</th>
                            <th>Show Day</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                                <td>@Model.Id</td>
                                <td>@Model.movieName</td>
                                <td>@Model.showDate</td>
                                <td>@Model.showTime</td>
                                <td>@Model.showDay</td>
                            </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
