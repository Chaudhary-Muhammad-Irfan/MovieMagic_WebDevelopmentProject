@model List<ViewModel>
@foreach (var vm in Model)
{
    <div class="movie-details row">
        <div class="col-md-4">
            <img src="~/@vm.Movie.ImageURL" alt="Movie Poster" class="poster img-fluid">
            <div class="d-flex mb-2">
                <form asp-action="DeleteMovie" asp-route-id="@vm.Movie.Id" method="post" style="margin-right: 10px;">
                    <input type="submit" value="Delete Movie" class="btn btn-common btn-delete" onclick="return confirm('Are you sure you want to delete this movie?');">
                </form>
                <form asp-action="AddShow" asp-route-id="@vm.Movie.Id" method="get">
                    <input type="submit" value="Add Show" class="btn btn-common btn-add-show">
                </form>
            </div>
        </div>
        <div class="col-md-8">
             <h2>@vm.Movie.Name</h2>
                <p>@vm.Movie.Description</p>
            <div class="table-custom">
                @if (vm.Shows.Any())
                {
                    <table class="table table-bordered mt-4">
                        <thead>
                            <tr>
                                <th>ShowID</th>
                                <th>ShowDate</th>
                                <th>ShowTime</th>
                                <th>ShowDay</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var show in vm.Shows)
                            {
                                <tr>
                                    <td>@show.Id</td>
                                    <td>@show.showDate.ToShortDateString()</td>
                                    <td>@show.showTime</td>
                                    <td>@show.showDay</td>
                                    <td>
                                        <form asp-action="DeleteShow" asp-route-id="@show.Id" method="post" style="display:inline;">
                                            <input type="submit" value="Delete Show" class="btn btn-common btn-delete" onclick="return confirm('Are you sure you want to delete this show?');">
                                        </form>
                                        <form asp-action="UpdateShow" asp-route-id="@show.Id" method="get" style="display:inline;">
                                            <input type="submit" value="Update Show" class="btn btn-common btn-update" onclick="return confirm('Are you sure you want to update this show?');">
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-info mt-4" role="alert">
                        No shows available yet.
                    </div>
                }
            </div>
        </div>
    </div>
}