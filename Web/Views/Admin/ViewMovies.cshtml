@model List<ViewModel>
@{
    Layout = "_AdminLayout";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Movie Details</title>
    <link href="~/css/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Arial', sans-serif;
        }
        .movie-header {
            color: #343a40;
            text-align: center;
            font-size: 40px;
            font-weight: 700;
            margin: 50px 0;
            border-bottom: 3px solid #dee2e6;
            padding-bottom: 15px;
        }
        .movie-details {
            margin-top: 20px;
            border: 1px solid #e0e0e0;
            padding: 20px;
            border-radius: 12px;
            background-color: #ffffff;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
        }

            .movie-details:hover {
                border-color: #007bff;
                box-shadow: 0 12px 24px rgba(0, 0, 0, 0.2);
            }

        .poster {
            width: 100%;
            height: 350px;
            object-fit: cover;
            border-radius: 12px;
            margin-bottom: 15px;
            transition: transform 0.3s ease;
        }

            .poster:hover {
                transform: scale(1.05);
            }

        .btn-common {
            border-radius: 25px;
            padding: 10px 20px;
            margin-right: 10px;
            transition: background-color 0.3s ease, transform 0.3s ease;
            font-size: 14px;
        }

        .btn-delete {
            background-color: #dc3545;
            color: white;
        }

            .btn-delete:hover {
                background-color: #c82333;
            }

        .btn-update {
            background-color: #007bff;
            color: white;
        }

            .btn-update:hover {
                background-color: #0056b3;
            }

        .btn-add-show {
            background-color: #17a2b8;
            color: white;
        }

            .btn-add-show:hover {
                background-color: #138496;
            }
        .table-custom {
            background-color: #ffffff;
            border-radius: 8px;
            padding: 15px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            overflow-y: auto;
            max-height: 300px; /* Limit height for scrolling */
        }
            .table-custom th {
                background-color: #f8f9fa;
                font-weight: bold;
            }
            .table-custom tr:hover {
                background-color: #f1f3f5;
            }
        .btn-bottom {
            margin-bottom: 30px;
        }
        .search-container {
            margin-top: 30px;
            margin-bottom: 20px;
        }
            .search-container .form-control {
                border-radius: 25px;
                padding: 10px 15px;
            }
            .search-container .btn-outline-success {
                border-radius: 25px;
                padding: 10px 20px;
            }
    </style>
</head>
<body>
    <p class="text-center fw-bold fs-1 mt-5">All Movies</p>
    <div class="d-flex justify-content-end search-container p-3">
        <form class="d-flex" role="search">
            <input id="searchInput" class="form-control me-2" type="search" placeholder="Search Movies" aria-label="Search">
            <button class="btn btn-outline-success" id="search" type="submit">Search</button>
        </form>
    </div>
    <div id="moviesList" class="container">
        <partial name="_MoviesListPartial" model="Model"></partial>
    </div>
    <div class="text-center btn-bottom">
        <a href="@Url.Action("AddMovie")" class="btn btn-primary btn-common mt-4">Add Movie</a>
    </div>
    <script src="~/js/js/bootstrap.bundle.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#search').click(function (e) {
                e.preventDefault();  
                var Name = $('#searchInput').val();
                $.get('/Admin/Search', { MovieName: Name }, function (result) {
                    $('#moviesList').html(result).fadeIn('slow');
                        });
            });
        });
    </script>    
</body>
</html>