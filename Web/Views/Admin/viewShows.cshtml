@model List<CORE.Entities.MovieShows>
@{
    Layout = "_AdminLayout";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Movie Shows</title>
    <link href="~/css/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f0f2f5;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .table-hover tbody tr:hover {
            background-color: #e2e6ea;
            cursor: pointer;
        }

        .center-title {
            text-align: center;
            margin-bottom: 30px;
        }

        .container-bounded {
            border: 1px solid #dee2e6;
            border-radius: 12px;
            padding: 30px;
            background-color: #ffffff;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .table-container {
            border: 1px solid #dee2e6;
            border-radius: 12px;
            background-color: #ffffff;
        }

        .thead-light th {
            background-color: #007bff;
            color: #ffffff;
            text-align: center;
        }

        h1 {
            color: #007bff;
            font-size: 2.5rem;
            font-weight: bold;
        }

        .btn {
            margin-right: 10px;
            transition: background-color 0.3s, transform 0.2s;
        }

            .btn:hover {
                transform: translateY(-2px);
            }

        .btn-delete {
            margin-right: 10px;
        }

        .alert {
            margin-bottom: 20px;
        }

        .btn-danger {
            background-color: #dc3545;
            border-color: #dc3545;
        }

            .btn-danger:hover {
                background-color: #c82333;
                border-color: #bd2130;
            }

        .btn-primary {
            background-color: #007bff;
            border-color: #007bff;
        }

            .btn-primary:hover {
                background-color: #0056b3;
                border-color: #004085;
            }
    </style>
</head>
<body>
    <div class="container mt-4">
        <div class="container-bounded">
            <div class="center-title">
                <h1>Movie Shows</h1>
            </div>
            <div class="table-container">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["SuccessMessage"]
                    </div>
                }
                <table class="table table-hover ps-0">
                    <thead class="thead-light">
                        <tr>
                            <th>Show ID</th>
                            <th>Movie Name</th>
                            <th>Show Date</th>
                            <th>Show Time</th>
                            <th>Show Day</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model)
                        {
                            <tr>
                                <td>@m.Id</td>
                                <td>@m.movieName</td>
                                <td>@m.showDate.ToString("yyyy-MM-dd")</td>
                                <td>@m.showTime.ToString("hh\\:mm")</td>
                                <td>@m.showDay</td>
                                <td>
                                    <form asp-action="DeleteShow" asp-route-id="@m.Id" method="post" style="display:inline;">
                                        <input type="submit" value="Delete Show" class="btn btn-danger btn-delete" onclick="return confirm('Are you sure you want to delete this show?');">
                                    </form>
                                    <a href="/Admin/UpdateShow/@m.Id" class="btn btn-primary rounded-pill">Update</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <script src="~/js/js/bootstrap.bundle.js"></script>
</body>
</html>

















