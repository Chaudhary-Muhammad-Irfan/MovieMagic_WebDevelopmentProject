@{
    Layout = null;
}
<div>
    <h2>Confirm Your Booking</h2>
    <form id="bookingForm">
        <input type="hidden" id="ShowId" value="@Model.ShowId" />
        <input type="hidden" id="MovieId" value="@Model.MovieId" />
        <div>
            <label for="UserEmail">Email:</label>
            <input type="email" id="UserEmail" value="@Model.UserEmail" required />
        </div>
        <div>
            <label for="SeatNumbers">Seats:</label>
            <input type="text" id="SeatNumbers" value="@Model.SeatNumbers" readonly />
        </div>
        <div>
            <label for="TotalPrice">Total Price:</label>
            <input type="text" id="TotalPrice" value="@Model.TotalPrice" readonly />
        </div>
        <button type="button" id="confirmBookingBtn">Confirm Booking</button>
    </form>

    <div id="bookingResult"></div>
</div>

<script>
    $(document).ready(function () {
        $('#confirmBookingBtn').click(function () {
            var bookingData = {
                ShowId: $('#ShowId').val(),
                MovieId: $('#MovieId').val(),
                UserEmail: $('#UserEmail').val(),
                SeatNumbers: $('#SeatNumbers').val(),
                TotalPrice: $('#TotalPrice').val()
            };
            $.ajax({
                type: "POST",
                url: '@Url.Action("ConfirmBooking", "Booking")',
                data: bookingData,
                success: function (response) {
                    if (response.success) {
                        $('#bookingResult').html('<p>Booking confirmed successfully!</p>');
                    } else {
                        $('#bookingResult').html('<p>There was an error processing your booking: ' + response.message + '</p>');
                    }
                },
                error: function () {
                    $('#bookingResult').html('<p>There was an error processing your booking. Please try again later.</p>');
                }
            });
        });
    });
</script>
