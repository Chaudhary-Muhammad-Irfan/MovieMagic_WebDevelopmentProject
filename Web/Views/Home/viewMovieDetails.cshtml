@model ViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Movie Details</title>
    <link href="~/css/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f8f9fa;
        }

        .container {
            max-width: 1200px;
            margin: 50px auto;
            background-color: #fff;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
        }

        .trailer-container {
            position: relative;
            overflow: hidden;
            width: 100%;
            padding-top: 40%;
        }

            .trailer-container iframe {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
            }

        .image-container {
            display: flex;
            justify-content: space-around;
            margin-top: 30px;
        }

            .image-container img {
                width: 150px;
                height: 150px;
                border-radius: 50%;
                margin-bottom: 10px;
            }

        .actor-name {
            text-align: center;
            font-weight: bold;
        }

        .show-timings {
            margin-top: 30px;
        }

        .table-hover tbody tr:hover {
            background-color: rgba(0, 0, 0, 0.05);
        }
    </style>
</head>
<body>
    <div class="container">
        <h2 class="mb-4 text-center">@Model.Movie.Name</h2>
        <div class="trailer-container">
            <iframe width="100%" height="100%" src="https://www.youtube.com/embed/JKa05nyUmuQ?si=oljOXX-lx1CEyA17" frameborder="0" allowfullscreen></iframe>
        </div>
        <div class="image-container">
            <div>
                <img src="~/Images/yash.jpg" alt="Image 1">
                <p class="actor-name">Yash</p>
            </div>
            <div>
                <img src="~/Images/sanjay.jpg" alt="Image 2">
                <p class="actor-name">Sanjay Dutt</p>
            </div>
            <div>
                <img src="~/Images/srinidhi.jpeg" alt="Image 3">
                <p class="actor-name">Srinidhi</p>
            </div>
        </div>
        <div class="show-timings">
            <h3>Show Timings</h3>
            @if (Model.Shows != null && Model.Shows.Any())
            {
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Show Number</th>
                            <th>Show Date</th>
                            <th>Show Time</th>
                            <th>Show Day</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var show in Model.Shows)
                        {
                            <tr>
                                <td>@show.Id</td>
                                <td>@show.showDate.ToString("yyyy-MM-dd")</td>
                                <td>@show.showTime.ToString(@"hh\:mm")</td>
                                <td>@show.showDay</td>
                                <td><a asp-controller="Booking" asp-action="BookTicket" asp-route-movieId="@Model.Movie.Id" asp-route-showId="@show.Id"><button type="button" class="btn btn-primary">Book Now</button></a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-center fw-bold fs-5">No shows available yet.</p>
            }
        </div>
    </div>
    <script src="~/js/js/bootstrap.bundle.js"></script>
</body>
</html>
