@{
    Layout = "_Layout";
}
<link href="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet">
<link href="~/css/homecss.css" rel="stylesheet" />
<link href="~/css/contact.css" rel="stylesheet" />
<div class="animation-screen">
    <div class="hero-section d-flex align-items-center justify-content-center text-center">
        <div class="hero-content">
            <h1 class="hero-title">Contact Us</h1>
            <p class="hero-description mx-5">
                Your feedback is important to us. We value your thoughts and suggestions to help us improve our services.
                Please feel free to reach out to us with any questions or comments.
            </p>
            <div class="animated-characters">
                <div class="character"></div>
                <div class="character"></div>
                <div class="character"></div>
            </div>
        </div>
    </div>
</div>
<div class="contact">
    <div class="container">
        <div class="contactInfo">
            <div class="box">
                <div class="icon" style="background-color: #2196F3;"><ion-icon name="location-outline"></ion-icon></div>
                <div class="text">
                    <h3>Address</h3>
                    <p>Punjab University Old Campus,<br>New Anarkali, Lahore</p>
                </div>
            </div>
            <div class="box">
                <div class="icon" style="background-color: #2196F3;"><ion-icon name="call-outline"></ion-icon></div>
                <div class="text">
                    <h3>Phone</h3>
                    <p>+92 310-4354500</p>
                </div>
            </div>
            <div class="box">
                <div class="icon" style="background-color: #2196F3;"><ion-icon name="mail-outline"></ion-icon></div>
                <div class="text">
                    <h3>Email</h3>
                    <p>BSEF21M010@pucit.edu.pk</p>
                </div>
            </div>
        </div>

        <div class="form-container">
            <div class="form">
                <form action="">
                    <h2>Send Message</h2>
                    <div class="input-group">
                        <div class="input-boundary">
                            <label for="Name">Name</label>
                            <input type="text" id="Name" required>
                        </div>
                        <div class="input-boundary">
                            <label for="email">Email</label>
                            <input type="email" id="email" required>
                        </div>
                    </div>
                    <div class="input-boundary">
                        <label for="topic">Topic</label>
                        <input type="text" id="topic" required>
                    </div>
                    <div class="input-boundary">
                        <label for="message">Message</label>
                        <textarea id="message" required></textarea>
                    </div>
                    <div class="input">
                        <input type="submit" value="Send">
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="map">
        <h3>Find Us</h3>
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d13602.18770313874!2d74.30092843955076!3d31.554183431776235!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x391904c841b156f9%3A0x53ad743c64b5db17!2sPunjab%20University%20Old%20Campus%2C%20Lahore!5e0!3m2!1sen!2s!4v1682295794983!5m2!1sen!2s"
                width="100%" height="400" style="border:0;" allowfullscreen="" loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>

    <div class="follow-us">
        <h3>Follow Us</h3>
        <div class="social-icons">
            <a href="#"><ion-icon name="logo-facebook" style="color: #3b5998;"></ion-icon></a>
            <a href="#"><ion-icon name="logo-twitter" style="color: #1DA1F2;"></ion-icon></a>
            <a href="#"><ion-icon name="logo-instagram" style="color: #E1306C;"></ion-icon></a>
            <a href="#"><ion-icon name="logo-linkedin" style="color: #0077B5;"></ion-icon></a>
            <a href="#"><ion-icon name="logo-youtube" style="color: #FF0000;"></ion-icon></a>
        </div>
    </div>
</div>