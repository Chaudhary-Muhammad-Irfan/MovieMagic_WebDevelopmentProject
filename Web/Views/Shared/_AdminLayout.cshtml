<link href="~/css/css/bootstrap.min.css" rel="stylesheet" />
<link href="~/css/index.css" rel="stylesheet" />
<style>
    body {
        padding-top: 56px;
    }
</style>
<nav class="navbar navbar-expand-lg bg-body-tertiary fixed-top">
    <div class="container">
        <ion-icon name="film-outline" class="fs-3 me-2"></ion-icon>
        @Html.ActionLink("Movie Magic", "ViewMovies", "Admin", null, new { @class = "navbar-brand me-5" })
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    @Html.ActionLink("Movies", "ViewMovies", "Admin", null, new { @class = "nav-link hover:text-info text-decoration-none position-relative" })
                </li>
                <li class="nav-item">
                    @Html.ActionLink("Shows", "viewShows", "Admin", null, new { @class = "nav-link hover:text-info text-decoration-none position-relative" })
                </li>
                @* <li class="nav-item">
                    @Html.ActionLink("ViewBookings", "ViewBookings", "Admin", null, new { @class = "nav-link hover:text-info text-decoration-none position-relative" })
                </li> *@
                <li class="nav-item">
                    @Html.ActionLink("Registered Users", "ViewUsers", "Admin", null, new { @class = "nav-link hover:text-info text-decoration-none position-relative" })
                </li>
            </ul>
            <partial name="_LoginPartial"></partial>
        </div>
    </div>
</nav>
@RenderBody();
<script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
<script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
<script src="~/js/js/bootstrap.bundle.js"></script>